    {
        "id": "b1b2c3d4e5f60001",
        "type": "function",
        "z": "06047bf462c9e047",
        "name": "Bulb Controller",
        "func": "const command = String(msg.payload).toUpperCase();\n\nif (command === 'ON') {\n    node.send([\n        { payload: 'ON' },\n        { payload: true },\n        { payload: 'ON' }\n    ]);\n    return null;\n}\n\nif (command === 'OFF') {\n    node.send([\n        { payload: 'OFF' },\n        { payload: false },\n        { payload: 'OFF' }\n    ]);\n    return null;\n}\n\nreturn null;",
        "outputs": 3,
