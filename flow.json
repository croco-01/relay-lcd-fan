    {
        "id": "990df92c4f40400b",
        "type": "function",
        "z": "06047bf462c9e047",
        "name": "Build pinctrl Bulb GPIO23",
        "func": "const command = String(msg.payload).toUpperCase();\n\nif (command === 'ON') {\n    msg.payload = 'pinctrl set 23 op dl';\n} else {\n    msg.payload = 'pinctrl set 23 ip pu';\n}\n\nreturn msg;",
